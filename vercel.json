{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(cv-classic|cv-noir).pdf",
      "has": [{ "type": "query", "key": "download" }],
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"Tsvetomir_Dimitrov_CV.pdf\"" }
      ]
    }
  ]
}
