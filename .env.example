# ╔════════════════════════════════════════════════════════════════════╗
# ║                    EmailJS Configuration                           ║
# ║       Powers the contact form (src/components/ui/ContactForm.tsx)   ║
# ╠════════════════════════════════════════════════════════════════════╣
# ║  1. Sign up / log in at https://dashboard.emailjs.com               ║
# ║  2. Copy this file to `.env` and fill in the values below           ║
# ║  3. For production: add the same 4 keys as GitHub repo Secrets      ║
# ║     (Settings → Secrets and variables → Actions). The deploy        ║
# ║     workflow bakes them into the build — `.env` is gitignored and   ║
# ║     never reaches the CI runner.                                    ║
# ╚════════════════════════════════════════════════════════════════════╝

# ── Service ID ────────────────────────────────────────────────────────
# The email service that actually sends the mail (Gmail, Outlook, etc.).
# Where: Dashboard → Email Services → your service → "Service ID".
# Looks like: service_xxxxxxx
VITE_EMAILJS_SERVICE_ID=your_service_id

# ── Template ID — English ─────────────────────────────────────────────
# The template used when the site language is English.
# Where: Dashboard → Email Templates → "React resume - EN" → "Template ID".
# Looks like: template_xxxxxxx
# NOTE: template variables must match the form fields exactly:
#       {{name}} {{email}} {{subject}} {{message}}
VITE_EMAILJS_TEMPLATE_ID_EN=your_english_template_id

# ── Template ID — Bulgarian ───────────────────────────────────────────
# The template used when the site language is Bulgarian.
# Where: Dashboard → Email Templates → "React resume - BG" → "Template ID".
# Looks like: template_xxxxxxx
# NOTE: same field variables as the EN template (just translated copy).
VITE_EMAILJS_TEMPLATE_ID_BG=your_bulgarian_template_id

# ── Public Key ────────────────────────────────────────────────────────
# Your account's public API key. Safe to ship in the client bundle.
# Where: Dashboard → Account → General → "Public Key"
#        (also listed under Account → API Keys).
# Looks like: a short alphanumeric string, e.g. AbC12_dEfGh34IjK
VITE_EMAILJS_PUBLIC_KEY=your_public_key
